-- THAIIIFMFYT MOBILE GUI

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("THAIIIFMFYT_Remotes")

local gui = Instance.new("ScreenGui")
gui.Name = "THAIIIFMFYT_GUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 260, 0, 390)
frame.Position = UDim2.new(0, 20, 0.25, 0)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 45)
title.BackgroundTransparency = 1
title.Text = "THAIIIFMFYT"
title.TextColor3 = Color3.fromRGB(255, 220, 0)
title.TextScaled = true
title.Parent = frame

local function makeButton(text, y, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0.88, 0, 0, 38)
    button.Position = UDim2.new(0.06, 0, 0, y)
    button.Text = text
    button.TextScaled = true
    button.BackgroundColor3 = Color3.fromRGB(55, 65, 90)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Parent = frame

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = button

    button.Activated:Connect(callback)
    return button
end

makeButton("Speed 50", 55, function()
    remotes.SetSpeed:FireServer(50)
end)

makeButton("Speed 100", 100, function()
    remotes.SetSpeed:FireServer(100)
end)

local jumpEnabled = false
local jumpButton

jumpButton = makeButton("Infinite Jump: OFF", 145, function()
    jumpEnabled = not jumpEnabled
    jumpButton.Text = "High Jump: " .. (jumpEnabled and "ON" or "OFF")
    remotes.SetJump:FireServer(jumpEnabled)
end)

makeButton("Buy Noob - 100 Coins", 190, function()
    remotes.BuyBrainrot:FireServer("Noob")
end)

makeButton("Buy Cat - 500 Coins", 235, function()
    remotes.BuyBrainrot:FireServer("Cat")
end)

makeButton("Buy Dragon - 2500 Coins", 280, function()
    remotes.BuyBrainrot:FireServer("Dragon")
end)

local locked = false

local lockButton
lockButton = makeButton("Lock Base: OFF", 325, function()
    locked = not locked
    lockButton.Text = "Lock Base: " .. (locked and "ON" or "OFF")
    remotes.LockBase:FireServer(locked)
end)

print("THAIIIFMFYT GUI loaded!")